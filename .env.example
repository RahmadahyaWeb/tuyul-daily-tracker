# Neon PostgreSQL Connection URL
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

# Vercel Postgres Integration (Optional / Supported)
POSTGRES_URL="postgresql://user:password@host/neondb?sslmode=require"

# AES-256 Encryption Secret (64 hex characters)
ENCRYPTION_SECRET="7f8b9a1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f90"

# Session JWT Signing Secret (Minimum 32 characters)
SESSION_SECRET="tuyul-tracker-super-secret-session-key-change-in-production-min32chars"

# Initial Admin Credentials (used only during initial seed if empty)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="adminpassword123"

# Application Timezone
APP_TIMEZONE="Asia/Makassar"
