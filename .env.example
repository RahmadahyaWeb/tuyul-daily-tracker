# PostgreSQL Database URL (Compatible with Neon, Supabase, Vercel Postgres, Railway, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tuyul_tracker?schema=public"

# AES-256-GCM Encryption Secret (Must be 32 characters or 64 hex characters)
# Generate via: openssl rand -hex 32
ENCRYPTION_SECRET="7f8b9a1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f90"

# Session Secret for signed auth cookies
SESSION_SECRET="tuyul-tracker-super-secret-session-key-change-in-production-min32chars"

# Default Admin credentials created during seeding
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="adminpassword123"

# Application Timezone (Defaults to Asia/Makassar UTC+8)
APP_TIMEZONE="Asia/Makassar"
